<?xml version="1.0" encoding="utf-8"?>
<LayoutModificationTemplate Version="1" 
    xmlns="http://microsoft.com" 
    xmlns:defaultlayout="http://microsoft.com" 
    xmlns:start="http://microsoft.com" 
    xmlns:taskbar="http://microsoft.com">
  <CustomTaskbarLayoutCollection PinListPlacement="Replace">
    <defaultlayout:TaskbarLayout>
      <taskbar:TaskbarPinList>
        <taskbar:DesktopApp DesktopApplicationID="Microsoft.Windows.Explorer"/>
        <taskbar:DesktopApp DesktopApplicationLinkPath="%ProgramData%\Microsoft\Windows\Start Menu\Programs\Accessories\Notepad.lnk"/>
        <taskbar:DesktopApp DesktopApplicationLinkPath="%AppData%\Microsoft\Windows\Start Menu\Programs\Windows PowerShell\Windows PowerShell.lnk"/>
      </taskbar:TaskbarPinList>
    </defaultlayout:TaskbarLayout>
  </CustomTaskbarLayoutCollection>
</LayoutModificationTemplate>
