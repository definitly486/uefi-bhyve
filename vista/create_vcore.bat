@echo off
:: ===========================================================
:: Создание пользователя vcore с паролем 639639 при первой загрузке
:: ===========================================================

:: Проверка прав администратора (для безопасности)
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo Скрипт должен быть запущен от имени администратора!
    pause
    exit /b
)

:: -------------------------------
:: Создаём пользователя vcore
:: -------------------------------
net user vcore 639639 /add
if %errorlevel% neq 0 (
    echo Пользователь vcore уже существует или произошла ошибка!
) else (
    echo Пользователь vcore успешно создан.
)

:: -------------------------------
:: Добавляем пользователя в группу Администраторы
:: -------------------------------
net localgroup Administrators vcore /add
if %errorlevel% neq 0 (
    echo Не удалось добавить пользователя vcore в группу Администраторы.
) else (
    echo Пользователь vcore добавлен в группу Администраторы.
)

:: -------------------------------
:: Скрипт выполнен, удаляем запись RunOnce
:: -------------------------------
reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce" /v CreateVCoreUser /f >nul 2>&1

:: -------------------------------
echo ===========================================================
echo Пользователь vcore создан. Скрипт RunOnce завершён.
pause
exit